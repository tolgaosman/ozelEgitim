APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Özel Eğitim: uygulamaya özel ayarlar ---
# Ön görüşme talebi bildiriminin gideceği kurumsal e-posta adresi.
INQUIRY_RECIPIENT_EMAIL=

# Next.js ISR önbelleğini tazeleyen uç nokta ve paylaşılan gizli anahtar.
# Anahtar frontend/.env.local içindeki REVALIDATE_SECRET ile birebir aynı olmalı.
# Üretmek için: php -r "echo bin2hex(random_bytes(24));"
FRONTEND_REVALIDATE_URL=
FRONTEND_REVALIDATE_SECRET=

# Seeder'ın oluşturduğu yönetici hesabı (parola koda gömülmez).
ADMIN_SEED_NAME=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# API'ye çapraz-origin erişime izin verilen frontend adres(ler)i, virgülle
# ayrılmış liste (örn. http://localhost:3000,https://ozelegitim.example.com).
# Boş bırakılırsa hiçbir tarayıcı origin'ine izin verilmez (bkz. config/cors.php).
CORS_ALLOWED_ORIGINS=

# --- Üretim örneği ---
# Geliştirmede SQLite kullanılır (DB_CONNECTION=sqlite, başka ayar gerekmez).
# Üretimde aşağıdaki blok açılır; migration'lar her iki sürücüyle de uyumludur.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ozel_egitim
# DB_USERNAME=
# DB_PASSWORD=
#
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME=tls
